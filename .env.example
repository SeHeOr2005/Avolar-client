# ═══════════════════════════════════════════════════════════════════
#  AVOLAR web — variables de entorno del frontend
#  Todo lo que empieza por VITE_ queda PÚBLICO dentro del JavaScript del navegador:
#  aquí nunca van secretos, claves de Supabase ni contraseñas.
# ═══════════════════════════════════════════════════════════════════

# (opcional en desarrollo / OBLIGATORIA en producción si el API está en otro dominio)
# URL base del API, terminada en /api. Si se omite, se usa "/api" (mismo dominio o proxy de Vite).
#   Producción, ejemplo: VITE_API_URL=https://api.avolar.com/api
VITE_API_URL=

# (opcional, solo desarrollo) A dónde reenvía el servidor de Vite las peticiones /api.
# No se incluye en el bundle. Por defecto: http://localhost:4000
DEV_API_PROXY_TARGET=http://localhost:4000
